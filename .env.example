DATABASE_URL=postgres://postgres:postgres@localhost:5433/workspace_ai
# development, test or production (docs/adr/0002-explicit-app-env.md). Seed and migrate refuse anything else.
APP_ENV=development
BETTER_AUTH_SECRET=replace-with-a-local-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# AI provider: exactly one per deployment, no defaults. Keep EXACTLY ONE of the three blocks below active
# and the other two commented out, so AI_PROVIDER, AI_MODEL and AI_API_KEY each appear only once.

# Block 1: OpenAI. Needs AI_MODEL and AI_API_KEY.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=

# Block 2: any OpenAI-compatible server (Chat Completions), e.g. LM Studio on this machine. AI_API_KEY is optional.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=google/gemma-3-12b
# Polish model instead of Gemma: set AI_MODEL to the Bielik id shown by `lms ls` (see README, "Trying another model").

# Block 3: the deterministic fake provider, in development/test only.
# AI_PROVIDER=fake
# AI_FAKE_DELAY_MS=120

# Usage limits (server-side). Default shown; an invalid value falls back to the default.
USAGE_LIMIT_USER_PER_MINUTE=10
USAGE_LIMIT_WORKSPACE_PER_DAY=200
DEMO_USER_A_EMAIL=user-a@example.test
DEMO_USER_A_PASSWORD=
DEMO_USER_B_EMAIL=user-b@example.test
DEMO_USER_B_PASSWORD=
