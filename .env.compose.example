# Template for `docker compose up` (README: "Run with Docker Compose"). Copy to `.env` and fill in.
# `.env` is git-ignored and excluded from the image. Put no real secret in this template.

# PostgreSQL. Use URL-safe characters in the password (for example `openssl rand -hex 24`):
# it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# POSTGRES_USER=workspace_ai
# POSTGRES_DB=workspace_ai

# Random secret, at least 32 characters (for example `openssl rand -hex 32`).
BETTER_AUTH_SECRET=
# The public URL users open. Must match APP_PORT / your domain.
BETTER_AUTH_URL=http://localhost:3000
# Host port for the app (default 3000).
# APP_PORT=3000

# AI provider: a REAL provider is required. The container runs with APP_ENV=production, which refuses
# AI_PROVIDER=fake. Keep exactly one of the two blocks below active.

# Block 1: OpenAI.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=

# Block 2: an OpenAI-compatible server. From inside a container, localhost is the container itself:
# for LM Studio on the Docker host use http://host.docker.internal:1234/v1.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://host.docker.internal:1234/v1
# AI_MODEL=google/gemma-3-12b
# AI_API_KEY=

# Usage limits (optional; defaults shown).
# USAGE_LIMIT_USER_PER_MINUTE=10
# USAGE_LIMIT_WORKSPACE_PER_DAY=200
